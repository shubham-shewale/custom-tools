# ================================================================
# Aqua Security MCP Server Environment Configuration (.env)
# Copy this file to .env:  cp .env.example .env
# ================================================================

# --- Required Authentication Credentials ---
AQUA_API_KEY=your_aqua_api_key_here
AQUA_API_SECRET=your_aqua_api_secret_here

# --- Aqua Endpoints & Regions (Configured via .env) ---
# Default is EU Region (eu-central-1):
AQUA_BASE_URL=https://eu-central-1.edge.cloud.aquasec.com
AQUA_TOKEN_URL=https://eu-1.api.cloudsploit.com/v2/tokens

# Example for US Region:
# AQUA_BASE_URL=https://cloud.aquasec.com
# AQUA_TOKEN_URL=https://api.cloudsploit.com/v2/tokens

# Example for APAC Region:
# AQUA_BASE_URL=https://asia-1.edge.cloud.aquasec.com
# AQUA_TOKEN_URL=https://asia-1.api.cloudsploit.com/v2/tokens

# --- Operational & Safety Guardrails ---
# Set to true to block all state modifications (POST, PUT, DELETE)
AQUA_READ_ONLY=false

# HTTP request timeout in seconds (Default: 30.0)
AQUA_REQUEST_TIMEOUT=30.0
